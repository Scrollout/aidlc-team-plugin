{
  "kinds": {
    "intent": {
      "title": "{{id}} {{title}}",
      "body": "issue.md",
      "labels": ["requirements", "decisions"],
      "assignees": "board.assignees",
      "type": "Feature",
      "milestone": { "title": "{{id}} {{title}}", "due": "board.target" }
    },
    "unit": {
      "title": "{{id}} {{title}}",
      "body": "issue.md",
      "labels": ["requirements", "decisions", "slices", "layer", "lane", "modules"],
      "assignees": "board.assignees",
      "type": "Task",
      "milestone": "parent",
      "parent": { "kind": "intent", "from": "intent" },
      "blockedBy": "depends"
    },
    "fix": {
      "title": "{{id}} {{title}}",
      "body": "issue.md",
      "labels": ["requirements", "decisions", "slices", "layer", "lane", "modules"],
      "assignees": "board.assignees",
      "type": "Bug",
      "blockedBy": "depends"
    }
  },
  "fields": {
    "Status": {
      "type": "SINGLE_SELECT",
      "from": "status",
      "options": ["Todo", "In Progress", "In review", "On hold", "Done"],
      "map": {
        "draft": "Todo",
        "approved": "Todo",
        "stale": "Todo",
        "blocked": "Todo",
        "building": "In Progress",
        "fix": "In Progress",
        "started": "In Progress",
        "reported": "In review",
        "reviewing": "In review",
        "reviewed": "In review",
        "gated": "In review",
        "stopped": "On hold",
        "escalated": "On hold",
        "held": "On hold",
        "merged": "Done",
        "released": "Done"
      }
    },
    "Cuts done": { "type": "NUMBER", "from": "board.cutsDone" }
  },
  "jira": {
    "kinds": {
      "intent": { "type": "Epic", "body": "workitem.md" },
      "unit": { "type": "Story", "body": "workitem.md" },
      "fix": { "type": "Task", "body": "workitem.md" }
    },
    "fields": {
      "Status": {
        "options": ["To Do", "In Progress", "Done"],
        "map": {
          "draft": "To Do",
          "approved": "To Do",
          "stale": "To Do",
          "blocked": "To Do",
          "held": "To Do",
          "building": "In Progress",
          "fix": "In Progress",
          "started": "In Progress",
          "reported": "In Progress",
          "reviewing": "In Progress",
          "reviewed": "In Progress",
          "gated": "In Progress",
          "stopped": "In Progress",
          "escalated": "In Progress",
          "merged": "Done",
          "released": "Done"
        }
      }
    }
  }
}
