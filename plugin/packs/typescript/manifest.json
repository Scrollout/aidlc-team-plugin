{
  "stack": "typescript",
  "detect": ["tsconfig.json"],
  "sources": "\\.(ts|tsx|mts)$",
  "imports": {
    "resolve": "relative",
    "patterns": [{ "path": "(?:from\\s+|require\\(\\s*|import\\(\\s*)['\"](\\.{1,2}\\/[^'\"]+)['\"]" }]
  },
  "values": {
    "skipLines": ["^\\s*(?:import|export)\\b.*\\bfrom\\s", "^\\s*import\\s+['\"]", "\\brequire\\(\\s*['\"]", "^\\s*(?://|/?\\*)"],
    "allow": ["^use strict$", "^(?:Accept|Authorization|Content-Type|ETag|If-Match|If-None-Match|Location|Retry-After|application/json)$", "^(?:https?|Bearer )$"]
  },
  "stringLiteral": "([\"'`])((?:\\\\.|(?!\\1)[^\\\\])*)\\1",
  "folders": { "domain": "src/domains/{{domain}}", "pipeline": "src/pipeline/{{stage}}", "foundation": "src/foundation/{{kit}}", "adapter": "src/adapters/{{system}}", "runtime": "src/runtimes/{{deployable}}" },
  "layers": { "ui": "ui", "interface": "interface", "application": "application", "model": "model", "infrastructure": "infrastructure" },
  "sliceFolder": "{{dir}}/{{slice}}",
  "slicePaths": { "ui.web": "{{dir}}/{{slice}}/ui/web", "ui.cli": "{{dir}}/{{slice}}/ui/cli", "interface": "{{dir}}/{{slice}}/interface", "application": "{{dir}}/{{slice}}/application", "model": "{{dir}}/model", "infrastructure": "{{dir}}/infrastructure", "migration": "migrations/{{domain}}" },
  "surfaces": { "client": "client", "events": "events", "server": "interface" },
  "migrations": "migrations/{{domain}}",
  "scaffold": {
    "domain": [["domain/model.ts", "{{dir}}/model/{{singular}}.ts"], ["domain/events.ts", "{{dir}}/events/events.ts"], ["domain/client.ts", "{{dir}}/client/client.ts"], ["domain/infrastructure.ts", "{{dir}}/infrastructure/infrastructure.ts"], ["domain/interface.ts", "{{dir}}/interface/interface.ts"], ["domain/migration.sql", "migrations/{{domain}}/0001_create_{{domain}}.sql"]],
    "slice": [["slice/screen.ts", "{{dir}}/{{operation}}/ui/web/screen.ts", "ui.web"], ["slice/screen.spec.ts", "{{dir}}/{{operation}}/ui/web/screen.spec.ts", "ui.web"], ["slice/command.ts", "{{dir}}/{{operation}}/ui/cli/command.ts", "ui.cli"], ["slice/command.spec.ts", "{{dir}}/{{operation}}/ui/cli/command.spec.ts", "ui.cli"], ["slice/route.ts", "{{dir}}/{{operation}}/interface/route.ts", "interface"], ["slice/route.spec.ts", "{{dir}}/{{operation}}/interface/route.spec.ts", "interface"], ["slice/handler.ts", "{{dir}}/{{operation}}/application/handler.ts", "application"], ["slice/handler.spec.ts", "{{dir}}/{{operation}}/application/handler.spec.ts", "application"]],
    "foundation": [["foundation.ts", "{{dir}}/{{kit}}.ts"]],
    "pipeline": [["pipeline.ts", "{{dir}}/{{stage}}.ts"]],
    "adapter": [["adapter.ts", "{{dir}}/{{system}}.ts"]],
    "runtime": [["runtime.ts", "{{dir}}/main.ts"]]
  },
  "naming": { "grammar": {
    "event": { "files": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mts", "api/**/*.yaml"], "find": "(?:^|[\\s'\"`:])({{Namespace}}\\.[A-Za-z0-9.]+)(?=$|[\\s'\"`,])" },
    "permission": { "files": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mts", "api/**/*.yaml"], "find": "(?:^|[\\s'\"`:])({{Namespace}}/(?:[^\\s'\"`/]+/)*(?i:{{actions}})[A-Za-z0-9]*)(?=$|[\\s'\"`,])" }
  } },
  "compileError": "ERR_MODULE_NOT_FOUND|SyntaxError: |does not provide an export named",
  "eventType": "Type\\s*=\\s*['\"]([^'\"]+)['\"]",
  "reference": { "domain": "reference/src/domains/notes", "command": "reference/src/domains/notes/createnote", "query": "reference/src/domains/notes/getnote" }
}
