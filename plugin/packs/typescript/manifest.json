{
  "stack": "typescript",
  "detect": ["tsconfig.json"],
  "sources": "\\.(ts|tsx|mts)$",
  "imports": {
    "resolve": "relative",
    "patterns": [{ "path": "(?:from\\s+|require\\(\\s*|import\\(\\s*)['\"](\\.{1,2}\\/[^'\"]+)['\"]" }]
  },
  "values": {
    "skipLines": ["^\\s*(?:import|export)\\b.*\\bfrom\\s", "^\\s*import\\s+['\"]", "\\brequire\\(\\s*['\"]", "^\\s*(?://|/?\\*)"],
    "allow": ["^use strict$", "^(?:Accept|Authorization|Content-Type|ETag|If-Match|If-None-Match|Location|Retry-After|application/json)$"]
  },
  "stringLiteral": "([\"'`])((?:\\\\.|(?!\\1)[^\\\\])*)\\1",
  "folders": { "domain": "src/domains/{{domain}}", "pipeline": "src/pipeline/{{stage}}", "foundation": "src/foundation/{{kit}}", "adapter": "src/adapters/{{system}}", "runtime": "src/runtimes/{{deployable}}" },
  "layers": { "ui": "ui", "interface": "interface", "application": "application", "model": "model", "infrastructure": "infrastructure" },
  "slicePaths": { "ui.web": "{{dir}}/ui/web/{{slice}}", "ui.cli": "{{dir}}/ui/cli/{{slice}}", "interface": "{{dir}}/interface/{{slice}}.ts", "application": "{{dir}}/application/{{slice}}", "model": "{{dir}}/model", "infrastructure": "{{dir}}/infrastructure", "migration": "migrations/{{domain}}" },
  "surfaces": { "client": "client", "events": "events", "server": "interface" },
  "migrations": "migrations/{{domain}}",
  "scaffold": {
    "domain": [["domain/model.ts", "{{dir}}/model/{{singular}}.ts"], ["domain/events.ts", "{{dir}}/events/events.ts"], ["domain/client.ts", "{{dir}}/client/client.ts"], ["domain/infrastructure.ts", "{{dir}}/infrastructure/infrastructure.ts"], ["domain/interface.ts", "{{dir}}/interface/interface.ts"], ["domain/migration.sql", "migrations/{{domain}}/0001_create_{{domain}}.sql"]],
    "slice": [["slice/screen.ts", "{{dir}}/ui/web/{{operation}}/screen.ts", "ui.web"], ["slice/screen.spec.ts", "{{dir}}/ui/web/{{operation}}/screen.spec.ts", "ui.web"], ["slice/command.ts", "{{dir}}/ui/cli/{{operation}}/command.ts", "ui.cli"], ["slice/command.spec.ts", "{{dir}}/ui/cli/{{operation}}/command.spec.ts", "ui.cli"], ["slice/route.ts", "{{dir}}/interface/{{operation}}.ts", "interface"], ["slice/route.spec.ts", "{{dir}}/interface/{{operation}}.spec.ts", "interface"], ["slice/handler.ts", "{{dir}}/application/{{operation}}/handler.ts", "application"], ["slice/handler.spec.ts", "{{dir}}/application/{{operation}}/handler.spec.ts", "application"]],
    "foundation": [["foundation.ts", "{{dir}}/{{kit}}.ts"]],
    "pipeline": [["pipeline.ts", "{{dir}}/{{stage}}.ts"]],
    "adapter": [["adapter.ts", "{{dir}}/{{system}}.ts"]],
    "runtime": [["runtime.ts", "{{dir}}/main.ts"]]
  },
  "compileError": "ERR_MODULE_NOT_FOUND|SyntaxError: |does not provide an export named",
  "eventType": "Type\\s*=\\s*['\"]([^'\"]+)['\"]",
  "reference": { "domain": "reference/src/domains/notes", "command": "reference/src/domains/notes/application/createnote", "query": "reference/src/domains/notes/application/getnote" }
}
