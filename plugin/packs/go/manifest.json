{
  "stack": "go",
  "detect": ["go.mod"],
  "module": { "file": "go.mod", "pattern": "^module\\s+(\\S+)" },
  "sources": "\\.go$",
  "imports": {
    "resolve": "module",
    "patterns": [
      { "block": "^import\\s*\\(([\\s\\S]*?)\\)", "flags": "m", "path": "\"([^\"]+)\"" },
      { "path": "^import\\s+(?:[\\w.]+\\s+)?\"([^\"]+)\"", "flags": "m" }
    ]
  },
  "values": {
    "skipLines": ["^\\s*(?:package|import)\\s", "^\\s*(?:[\\w.]+\\s+)?\"[^\"]+\"\\s*$", "^\\s*//"],
    "allow": ["^(?:\\w+:\"[^\"]*\"\\s*)+$", "^(?:%[-+# 0-9.]*[a-zA-Z]|[^\\p{L}])*$", "^(?:Accept|Authorization|Content-Type|ETag|If-Match|If-None-Match|Location|Retry-After|application/json)$", "^(?:https?|Bearer )$"]
  },
  "stringLiteral": "([\"'`])((?:\\\\.|(?!\\1)[^\\\\])*)\\1",
  "folders": { "domain": "internal/domains/{{domain}}", "pipeline": "internal/pipeline/{{stage}}", "foundation": "internal/foundation/{{kit}}", "adapter": "internal/adapters/{{system}}", "runtime": "cmd/{{deployable}}" },
  "layers": { "ui": "ui", "interface": "interface", "application": "application", "model": "model", "infrastructure": "infrastructure" },
  "sliceFolder": "{{dir}}/{{slice}}",
  "slicePaths": { "ui.cli": "{{dir}}/{{slice}}/ui/cli", "ui.template": "{{dir}}/{{slice}}/ui/template", "interface": "{{dir}}/{{slice}}/interface", "application": "{{dir}}/{{slice}}/application", "model": "{{dir}}/model", "infrastructure": "{{dir}}/infrastructure", "migration": "migrations/{{domain}}" },
  "surfaces": { "client": "client", "events": "events", "server": "interface" },
  "migrations": "migrations/{{domain}}",
  "scaffold": {
    "domain": [["domain/model.go", "{{dir}}/model/{{singular}}.go"], ["domain/events.go", "{{dir}}/events/events.go"], ["domain/client.go", "{{dir}}/client/client.go"], ["domain/infrastructure.go", "{{dir}}/infrastructure/infrastructure.go"], ["domain/interface.go", "{{dir}}/interface/interface.go"], ["domain/migration.sql", "migrations/{{domain}}/0001_create_{{domain}}.sql"]],
    "slice": [["slice/command.go", "{{dir}}/{{operation}}/ui/cli/command.go", "ui.cli"], ["slice/command_test.go", "{{dir}}/{{operation}}/ui/cli/command_test.go", "ui.cli"], ["slice/schema.json", "{{dir}}/{{operation}}/ui/template/schema.json", "ui.template"], ["slice/template_test.go", "{{dir}}/{{operation}}/ui/template/template_test.go", "ui.template"], ["slice/route.go", "{{dir}}/{{operation}}/interface/route.go", "interface"], ["slice/route_test.go", "{{dir}}/{{operation}}/interface/route_test.go", "interface"], ["slice/handler.go", "{{dir}}/{{operation}}/application/handler.go", "application"], ["slice/handler_test.go", "{{dir}}/{{operation}}/application/handler_test.go", "application"]],
    "foundation": [["foundation.go", "{{dir}}/{{kit}}.go"]],
    "pipeline": [["pipeline.go", "{{dir}}/{{stage}}.go"]],
    "adapter": [["adapter.go", "{{dir}}/{{system}}.go"]],
    "runtime": [["runtime.go", "{{dir}}/main.go"]]
  },
  "naming": { "grammar": {
    "event": { "files": ["cmd/**/*.go", "internal/**/*.go"], "find": "[\"`]({{Namespace}}\\.[A-Za-z0-9.]+)[\"`]" },
    "permission": { "files": ["cmd/**/*.go", "internal/**/*.go"], "find": "[\"`]({{Namespace}}/[^\"`\\s]+/(?:{{actions}}))[\"`]" }
  } },
  "compileError": "\\[(build|setup) failed\\]",
  "eventType": "Type\\s*=\\s*\"([^\"]+)\"",
  "reference": { "domain": "reference/internal/domains/notes", "command": "reference/internal/domains/notes/createnote", "query": "reference/internal/domains/notes/getnote" }
}
