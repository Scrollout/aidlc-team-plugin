{
  "name": "control-plane",
  "title": "Control plane",
  "description": "A horizontally scaling control plane: a stateless front door with a fixed governance pipeline, the metadata of every resource, long-running operations, deployments that converge, and events; providers plug in per namespace.",
  "layers": [
    { "id": "frontdoor", "kind": "runtime", "role": "the stateless front door: one entry for every request, routed by namespace", "applies": ["authenticate", "authorize", "policy", "lock", "throttle", "outcomeEvents", "statusContract"] },
    { "id": "authenticate", "kind": "pipeline", "role": "who is calling" },
    { "id": "authorize", "kind": "pipeline", "role": "whether the caller may do this on this scope" },
    { "id": "policy", "kind": "pipeline", "role": "whether the result obeys the rules set on its scope, a partial update judged as merged" },
    { "id": "lock", "kind": "pipeline", "role": "whether the scope is locked against change" },
    { "id": "throttle", "kind": "pipeline", "role": "how much budget the caller has left, reported on every answer" }
  ],
  "domains": [
    { "id": "resources", "kind": "domain", "role": "the metadata of every resource: its id, kind, scope and provider, reconciled with the provider", "slices": [{ "kind": "Command", "verb": "create", "useCase": "a client creates or replaces a resource in its scope, its metadata recorded", "cuts": ["interface", "application", "model", "infrastructure", "migration"], "entry": "frontdoor", "async": true, "emits": ["ResourceWritten"] }, { "kind": "Command", "verb": "delete", "useCase": "a client removes a resource, absent ones included", "cuts": ["interface", "application", "model", "infrastructure"], "entry": "frontdoor", "emits": ["ResourceDeleted"] }, { "kind": "Query", "verb": "get", "useCase": "a client reads one resource", "cuts": ["interface", "application"], "entry": "frontdoor" }, { "kind": "Query", "verb": "list", "useCase": "a client lists the resources of a scope", "cuts": ["interface", "application"], "entry": "frontdoor" }] },
    { "id": "operations", "kind": "domain", "role": "long-running operations: their status and their result", "slices": [{ "kind": "Query", "verb": "get", "useCase": "a client follows a long-running write to its status and result", "cuts": ["interface", "application"], "entry": "frontdoor" }] },
    { "id": "deployments", "kind": "domain", "role": "templates resolved into a graph of idempotent writes, run in parallel where independent, converging by re-applying", "slices": [{ "kind": "Command", "verb": "create", "useCase": "a client deploys a template, its writes converging by re-applying", "cuts": ["interface", "application", "model", "infrastructure", "migration"], "entry": "frontdoor", "async": true, "calls": ["resources"] }, { "kind": "Query", "verb": "get", "useCase": "a client reads where a deployment stands", "cuts": ["interface", "application"], "entry": "frontdoor" }] },
    { "id": "activity", "kind": "domain", "role": "the activity log and the events of every write, delete and action", "slices": [{ "kind": "Query", "verb": "list", "useCase": "a client reads the activity log of a scope", "cuts": ["interface", "application"], "entry": "frontdoor", "consumes": ["ResourceWritten", "ResourceDeleted"] }] }
  ],
  "extension": { "kind": "extension", "declares": ["namespace", "types", "longRunning"], "slices": [{ "kind": "Command", "verb": "create", "useCase": "a client creates or replaces a resource of the provider's type", "cuts": ["interface", "application", "model", "infrastructure"], "entry": "frontdoor" }, { "kind": "Command", "verb": "delete", "useCase": "a client removes one", "cuts": ["interface", "application", "model", "infrastructure"], "entry": "frontdoor" }, { "kind": "Query", "verb": "get", "useCase": "a client reads one", "cuts": ["interface", "application"], "entry": "frontdoor" }] },
  "contracts": [
    { "from": "frontdoor", "to": "authenticate", "via": "the request, in process" },
    { "from": "throttle", "to": "extension", "via": "the provider contract, by namespace" },
    { "from": "extension", "to": "resources", "via": "the metadata of each write" },
    { "from": "extension", "to": "activity", "via": "an event per write, delete and action" },
    { "from": "deployments", "to": "frontdoor", "via": "the same API every client uses" }
  ],
  "rules": [
    { "type": "stageOrder", "stages": ["authenticate", "authorize", "policy", "lock", "throttle"] },
    { "type": "extensionDeclaration", "kind": "extension", "declares": ["namespace", "types", "longRunning"] },
    { "type": "longRunning", "shapes": [{ "code": 201, "links": ["status"] }, { "code": 202, "links": ["result"] }], "deleteAbsent": 204 },
    { "type": "idempotency", "writes": "\\b(creates?|updates?|replaces?)\\b", "repeat": "\\b(again|repeated|twice)\\b.*\\bunchanged\\b" },
    { "type": "data", "classes": ["regional", "shared", "global"] },
    { "type": "events", "verbs": ["put", "patch", "post", "delete"] }
  ],
  "contract": { "grammar": { "path": { "template": "/providers/{{Namespace}}/{{typeCamel}}/{{{singularCamel}}Name}", "needs": ["org", "system", "domain"], "regex": "^/providers/[A-Z][A-Za-z0-9.]+/[a-z][A-Za-z0-9]*/\\{[a-z][A-Za-z0-9]*Name\\}$" } }, "segments": ["providers", "operations"], "providers": "providers", "resource": ["id", "name", "type"], "systemData": "systemData", "list": "value", "nextLink": "nextLink" },
  "fit": { "words": ["control plane", "resource provider", "resource providers", "providers", "deployments", "templates", "tenants", "scopes"] },
  "references": { "go": { "frontdoor": "reference/go/cmd/frontdoor", "stages": "reference/go/internal/pipeline/stages", "resources": "reference/go/internal/domains/resources", "operations": "reference/go/internal/domains/operations", "values": "reference/go/internal/foundation/values", "api": "reference/go/api" } }
}
